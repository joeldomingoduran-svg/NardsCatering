{
  "version": 2,
  "regions": ["hnd1"],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "Admin/**",
          "Customer/**",
          "Login/**",
          "Manager/**",
          "Staff/**",
          "Frontend/**",
          "capstone.imgs/**",
          "uploads/**",
          "node_modules/sweetalert2/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }]
}
