# Database Configuration - Required for app to run
DATABASE_URL=postgresql://postgres:<DATABASE_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Authentication - CRITICAL: Generate a strong random secret, at least 32 characters
# DO NOT use the example value in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=your-strong-random-secret-key-min-32-chars-generated-securely

# Email Configuration (for verification codes and password reset)
# Using Gmail or custom SMTP server
# If using Gmail: enable "App passwords" in Google Account security settings
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-not-regular-password

# Stripe Integration (for payment processing)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Server Configuration
PORT=3001

# Deployment Platform (Vercel, etc.)
VERCEL=false

# Node Environment
NODE_ENV=development

# Security Note:
# - Never commit actual secret values to version control
# - Keep .env out of git (it's already in .gitignore)
# - Rotate AUTH_TOKEN_SECRET regularly
# - Use unique, strong values for production
# - Check that all required variables are set before deployment
